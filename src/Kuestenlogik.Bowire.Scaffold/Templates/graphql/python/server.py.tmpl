# {{Service}} — scaffolded by Bowire from the spec in bowire-scaffold.json.
# The resolvers keep {{plural}} in memory, so every restart starts empty:
# replace the store with your own persistence and keep the schema.
# graphql-core on Python's own http.server: `pip install graphql-core`.
import json
import secrets
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from threading import Lock

from graphql import build_schema, graphql_sync

SCHEMA = build_schema((Path(__file__).parent / "schema.graphql").read_text(encoding="utf-8"))
FIELDS = [{{#fields}}"{{name}}", {{/fields}}]
store = {}
lock = Lock()


def from_args(item_id, args):
    return {"id": item_id, **{name: args.get(name) for name in FIELDS}}


def list_items(info):
    with lock:
        return [store[key] for key in sorted(store)]


def get_item(info, id):
    with lock:
        return store.get(id)


def create_item(info, **args):
    item = from_args(secrets.token_hex(16), args)
    with lock:
        store[item["id"]] = item
    return item


def update_item(info, id, **args):
    with lock:
        if id not in store:
            return None
        store[id] = from_args(id, args)
        return store[id]


def delete_item(info, id):
    with lock:
        return store.pop(id, None) is not None


# The root resolvers, one per field of Query and Mutation. A required
# argument is declared non-null in the schema, so GraphQL itself refuses an
# operation without it.
ROOT = {
    "{{gqlList}}": list_items,
    "{{entity}}": get_item,
    "create{{Entity}}": create_item,
    "update{{Entity}}": update_item,
    "delete{{Entity}}": delete_item,
}


class Handler(BaseHTTPRequestHandler):
    def read_body(self):
        # A client may send the body chunked (no Content-Length), as .NET's
        # JsonContent does; http.server does not undo that by itself.
        if "chunked" in (self.headers.get("Transfer-Encoding") or "").lower():
            data = b""
            while True:
                size = int(self.rfile.readline().split(b";")[0].strip() or b"0", 16)
                if size == 0:
                    self.rfile.readline()
                    return data
                data += self.rfile.read(size)
                self.rfile.readline()
        return self.rfile.read(int(self.headers.get("Content-Length") or 0))

    def do_POST(self):
        if self.path.split("?")[0] != "/graphql":
            self.send_response(404)
            self.end_headers()
            return
        try:
            request = json.loads(self.read_body() or b"{}")
        except json.JSONDecodeError as err:
            return self.reply(400, {"errors": [{"message": str(err)}]})
        result = graphql_sync(SCHEMA, request.get("query") or "", root_value=ROOT,
                              variable_values=request.get("variables"), operation_name=request.get("operationName"))
        body = {"data": result.data}
        if result.errors:
            body["errors"] = [error.formatted for error in result.errors]
        return self.reply(200, body)

    def reply(self, status, body):
        payload = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, format, *args):
        pass


if __name__ == "__main__":
    server = ThreadingHTTPServer(("{{Host}}", {{Port}}), Handler)
    print("listening on {{BaseUrl}}", flush=True)
    server.serve_forever()
