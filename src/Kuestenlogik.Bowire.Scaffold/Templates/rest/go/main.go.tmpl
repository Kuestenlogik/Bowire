func list{{Plural}}(w http.ResponseWriter, r *http.Request) {
	mu.Lock()
	items := make([]{{Entity}}, 0, len(store))
	for _, item := range store {
		items = append(items, item)
	}
	mu.Unlock()
	sort.Slice(items, func(i, j int) bool { return items[i].ID < items[j].ID })
	writeJSON(w, http.StatusOK, items)
}

func create{{Entity}}(w http.ResponseWriter, r *http.Request) {
	input, ok := readInput(w, r)
	if !ok {
		return
	}
	item := from(newID(), input)
	mu.Lock()
	store[item.ID] = item
	mu.Unlock()
	w.Header().Set("Location", "/{{route}}/"+item.ID)
	writeJSON(w, http.StatusCreated, item)
}

func get{{Entity}}(w http.ResponseWriter, r *http.Request) {
	mu.Lock()
	item, found := store[r.PathValue("id")]
	mu.Unlock()
	if !found {
		w.WriteHeader(http.StatusNotFound)
		return
	}
	writeJSON(w, http.StatusOK, item)
}

func update{{Entity}}(w http.ResponseWriter, r *http.Request) {
	id := r.PathValue("id")
	mu.Lock()
	_, found := store[id]
	mu.Unlock()
	if !found {
		w.WriteHeader(http.StatusNotFound)
		return
	}
	input, ok := readInput(w, r)
	if !ok {
		return
	}
	item := from(id, input)
	mu.Lock()
	store[id] = item
	mu.Unlock()
	writeJSON(w, http.StatusOK, item)
}

func delete{{Entity}}(w http.ResponseWriter, r *http.Request) {
	id := r.PathValue("id")
	mu.Lock()
	_, found := store[id]
	delete(store, id)
	mu.Unlock()
	if !found {
		w.WriteHeader(http.StatusNotFound)
		return
	}
	w.WriteHeader(http.StatusNoContent)
}

