{{#fields}}{{#Required}}    if input.{{rustName}}.is_none() {
        errors.insert("{{name}}".into(), serde_json::json!(["{{name}} is required"]));
    }
{{/Required}}{{/fields}}    if errors.is_empty() {
        return None;
