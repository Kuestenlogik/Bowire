type Store = Arc<Mutex<BTreeMap<String, {{Entity}}>>>;

#[tokio::main]
async fn main() {
    let store: Store = Arc::new(Mutex::new(BTreeMap::new()));
    let app = Router::new()
        .route("/{{route}}", get(list).post(create))
        .route("/{{route}}/{id}", get(read).put(update).delete(remove))
        .route("/openapi.yaml", get(|| async { ([(header::CONTENT_TYPE, "application/yaml")], OPENAPI) }))
        .with_state(store);
    let listener = tokio::net::TcpListener::bind("{{ListenAddress}}").await.expect("bind");
    println!("listening on {{BaseUrl}}");
    axum::serve(listener, app).await.expect("serve");
}

async fn list(State(store): State<Store>) -> Json<Vec<{{Entity}}>> {
    Json(store.lock().unwrap().values().cloned().collect())
}

async fn create(State(store): State<Store>, Json(input): Json<{{Entity}}Input>) -> Response {
    if let Some(problem) = validate(&input) {
        return problem;
    }
    let item = from(uuid::Uuid::new_v4().simple().to_string(), input);
    store.lock().unwrap().insert(item.id.clone(), item.clone());
    let location = format!("/{{route}}/{}", item.id);
    (StatusCode::CREATED, [(header::LOCATION, location)], Json(item)).into_response()
}

async fn read(State(store): State<Store>, Path(id): Path<String>) -> Response {
    match store.lock().unwrap().get(&id) {
        Some(item) => Json(item.clone()).into_response(),
        None => StatusCode::NOT_FOUND.into_response(),
    }
}

async fn update(State(store): State<Store>, Path(id): Path<String>, Json(input): Json<{{Entity}}Input>) -> Response {
    if !store.lock().unwrap().contains_key(&id) {
        return StatusCode::NOT_FOUND.into_response();
    }
    if let Some(problem) = validate(&input) {
        return problem;
    }
    let item = from(id.clone(), input);
    store.lock().unwrap().insert(id, item.clone());
    Json(item).into_response()
}

async fn remove(State(store): State<Store>, Path(id): Path<String>) -> StatusCode {
    match store.lock().unwrap().remove(&id) {
        Some(_) => StatusCode::NO_CONTENT,
        None => StatusCode::NOT_FOUND,
    }
}

fn from(id: String, input: {{Entity}}Input) -> {{Entity}} {
    {{Entity}} {
        id,
{{#fields}}        {{rustName}}: input.{{rustName}},
{{/fields}}    }
}

