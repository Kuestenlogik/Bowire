<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      The assembly + the executable + the dotnet-tool command are all
      `bowire` (lowercase) so end-users only ever type `bowire ...`
      after `dotnet tool install -g Kuestenlogik.Bowire.Tool`. The PackageId is
      KL-prefixed for consistency with the other Bowire packages —
      Kuestenlogik.Bowire (core), Kuestenlogik.Bowire.Protocol.* (plugins), Kuestenlogik.Bowire.Tool
      (this dotnet-tool / standalone CLI).
    -->
    <RootNamespace>Kuestenlogik.Bowire.App</RootNamespace>
    <AssemblyName>bowire</AssemblyName>
    <PackageId>Kuestenlogik.Bowire.Tool</PackageId>
    <Description>Bowire — the API workbench that embeds in your own service. This is the standalone CLI + browser UI. Discover, invoke, record, mock, and replay across gRPC, REST, GraphQL, MQTT, SignalR, WebSocket, SSE, MCP, OData, and Socket.IO — every first-party plugin pre-bundled. Run `bowire --url …` for the browser UI or `bowire list/describe/call` / `bowire mock` for grpcurl-style scripting and recording replay.</Description>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bowire</ToolCommandName>
    <!--
      Windows application icon for the compiled bowire.exe. Embedded as a
      PE resource so Task Manager, Explorer, and the title bar all show
      the Bowire mark when the tool runs standalone. Points directly at
      the repo-level images/bowire.ico, which the shared branding
      generator writes from scripts/branding/bowire_mark_source.svg
      (node scripts/branding/tool/generate-logos.mjs). The ICO is
      multi-resolution (16/24/32/48/64/128/256, the mark on its light
      tile) so Explorer picks the right size for every view.
    -->
    <ApplicationIcon>..\..\images\bowire.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Container image config — only kicks in when the build is invoked with
    `dotnet publish /t:PublishContainer`. Auto-picks an ASP.NET base image
    (Bowire is an ASP.NET app), the alpine family for size, OCI image
    format (open standard, broader runtime compatibility), exposes the
    default standalone port, and sets the working directory + image
    repository / labels. Tags + version come from the publish-container
    script and default to the project Version.
  -->
  <PropertyGroup>
    <ContainerRepository>kuestenlogik/bowire</ContainerRepository>
    <!--
      noble-chiseled-extra = Ubuntu Noble (24.04) chiseled distroless
      base + ICU + tzdata. Picks the smallest secure ASP.NET base image
      Microsoft ships, with no shell, no package manager, and a non-root
      `app` user enabled by default. The `-extra` suffix adds globalization
      support so culture-aware string operations keep working without an
      InvariantGlobalization audit. Drop the `-extra` if you've verified
      every code path uses StringComparison.Ordinal / InvariantCulture.
    -->
    <ContainerFamily>noble-chiseled-extra</ContainerFamily>
    <ContainerImageFormat>OCI</ContainerImageFormat>
    <ContainerWorkingDirectory>/app</ContainerWorkingDirectory>
    <!--
      Image tag(s) come from the publish-container script via
      -p:ContainerImageTags="$VERSION;latest". Setting both
      ContainerImageTag (singular) and ContainerImageTags (plural) at
      the same time is rejected by the SDK with CONTAINER2008, so we
      leave the default empty here and let the script ship the value.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ContainerPort Include="5080" Type="tcp" />
    <ContainerEnvironmentVariable Include="ASPNETCORE_URLS" Value="http://+:5080" />
    <ContainerLabel Include="org.opencontainers.image.title" Value="Bowire" />
    <ContainerLabel Include="org.opencontainers.image.description" Value="The API workbench that embeds in your own service. Browser UI and CLI for gRPC, REST, GraphQL, MQTT, SignalR, WebSocket, MCP and more." />
    <ContainerLabel Include="org.opencontainers.image.vendor" Value="Kuestenlogik" />
    <ContainerLabel Include="org.opencontainers.image.source" Value="https://github.com/Kuestenlogik/Bowire" />
    <ContainerLabel Include="org.opencontainers.image.licenses" Value="Apache-2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internals (like BowireConfiguration) to the shared test
         project. Tool is an exe rather than a library, so there's no
         external surface to protect — internals just keep CA1515 happy
         while the test project gets direct access via the friend
         assembly declaration. -->
    <InternalsVisibleTo Include="Kuestenlogik.Bowire.Tests" />
    <!-- #803: flows against a real MCP task server; the core test project has fake protocols with the mcp id. -->
    <InternalsVisibleTo Include="Kuestenlogik.Bowire.Protocol.Mcp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- #688: CLDR plural categories for the translations check of bowire docs. -->
    <EmbeddedResource Include="Cli\plural-categories.json" LogicalName="Kuestenlogik.Bowire.App.Cli.plural-categories.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- NuGet client library used by the `bowire plugin install`
         subcommand. Lets us resolve + download + extract a plugin
         package without shelling out to `dotnet restore` + `dotnet
         build` (and without requiring the .NET SDK on the install
         host — only the runtime). -->
    <PackageReference Include="NuGet.Protocol" />
    <!-- Lifts NuGet.Packaging's transitive Pkcs 8.0.1 out of the advisories
         listed in Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      #306 Phase G — Tool now depends on a single ProjectReference: the
      Bundle.Workbench meta-package, which transitively pulls in every
      Rail.* + Module.* + Protocol.* + Security + AI + Help + Telemetry
      + Workspace.Git + Mock + Mcp + AsyncApi the standalone CLI used
      to enumerate by hand. Adding a new built-in surface no longer
      means editing this csproj; add the package to Bundle.Workbench
      instead and the Tool picks it up automatically. Embedded hosts
      that want the same out-of-the-box experience reference
      Bundle.Workbench themselves; hosts that want a narrower surface
      pick Bundle.Minimal or assemble a per-package list.
    -->
    <ProjectReference Include="..\Kuestenlogik.Bowire.Bundle.Workbench\Kuestenlogik.Bowire.Bundle.Workbench.csproj" />
    <!-- Tool drives the CLI surface — needs the CLI contract package
         (carries System.CommandLine, IBowireCliCommand, the registry).
         Bundle.Workbench is silent on the CLI host because the CLI
         contract is host-specific (a server-side host like an embedded
         workbench doesn't need System.CommandLine). -->
    <ProjectReference Include="..\Kuestenlogik.Bowire.Cli\Kuestenlogik.Bowire.Cli.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!--
    #687 - bowirew.exe: the javaw / pythonw pattern. The same apphost, the
    same bowire.dll and entry point, with the PE subsystem set to GUI, so a
    Start-menu or desktop launch opens no console window. It is exactly what
    the SDK writes for OutputType=WinExe, made from the console apphost
    rather than by building the tool twice. bowire.exe stays the console
    program for terminals, scripts and CI. Only where an apphost exists (a
    Windows build or a win-* publish); a framework-dependent `dotnet tool`
    install has none and needs none.
  -->
  <UsingTask TaskName="WriteWindowedAppHost"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var bytes = System.IO.File.ReadAllBytes(Source);
        // e_lfanew at 0x3C names the PE header; after the 4-byte signature and
        // the 20-byte COFF header comes the optional header, whose Subsystem
        // field sits at offset 68 in both PE32 and PE32+.
        if (bytes.Length < 0x40 || bytes[0] != (byte)'M' || bytes[1] != (byte)'Z')
        {
            Log.LogError("WriteWindowedAppHost: " + Source + " is not a PE file.");
            return false;
        }
        var pe = System.BitConverter.ToInt32(bytes, 0x3C);
        var subsystem = pe + 4 + 20 + 68;
        if (pe <= 0 || subsystem + 2 > bytes.Length || bytes[pe] != (byte)'P' || bytes[pe + 1] != (byte)'E')
        {
            Log.LogError("WriteWindowedAppHost: " + Source + " has no PE header where its DOS header says.");
            return false;
        }
        // 2 = IMAGE_SUBSYSTEM_WINDOWS_GUI, 3 = IMAGE_SUBSYSTEM_WINDOWS_CUI.
        bytes[subsystem] = 2;
        bytes[subsystem + 1] = 0;
        System.IO.File.WriteAllBytes(Destination, bytes);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="WriteBowirew" AfterTargets="Build" Condition="Exists('$(OutDir)$(AssemblyName).exe')"
          Inputs="$(OutDir)$(AssemblyName).exe" Outputs="$(OutDir)bowirew.exe">
    <WriteWindowedAppHost Source="$(OutDir)$(AssemblyName).exe" Destination="$(OutDir)bowirew.exe" />
    <ItemGroup>
      <FileWrites Include="$(OutDir)bowirew.exe" />
    </ItemGroup>
  </Target>

  <!-- Not for a single-file publish: there bowire.exe is the whole tool, a
       copy would double the archive, and the portable archives have no
       shortcuts to point at it. The MSI publishes framework files beside a
       small apphost, which is where bowirew belongs. -->
  <Target Name="PublishBowirew" AfterTargets="Publish"
          Condition="Exists('$(PublishDir)$(AssemblyName).exe') And '$(PublishSingleFile)' != 'true'">
    <WriteWindowedAppHost Source="$(PublishDir)$(AssemblyName).exe" Destination="$(PublishDir)bowirew.exe" />
  </Target>
</Project>
