<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Bowire.Mcp — exposes the Bowire workbench itself as an MCP server, so AI agents (Claude Desktop, Cursor, Copilot) can drive discovery, invocation, recording, mocking, and replay through the Model Context Protocol. Sibling of Kuestenlogik.Bowire.Mock; the third row of the MCP surface area: Bowire as MCP server for its own operations (Kuestenlogik.Bowire.Protocol.Mcp covers the other two — Bowire as MCP client and as MCP adapter for fremd-protocols). Built on the official ModelContextProtocol C# SDK (2.0.x, MCP revision 2026-07-28). Mount via `services.AddBowireMcp() + endpoints.MapBowireMcp(...)` for the Streamable-HTTP transport, or run `bowire mcp serve` for stdio.</Description>
    <PackageId>Kuestenlogik.Bowire.Mcp</PackageId>
    <PackageTags>bowire;mcp;ai;claude;copilot;cursor;model-context-protocol;tools;workbench;developer-tools</PackageTags>
    <IsPackable>true</IsPackable>
    <!-- MCPEXP001/MCPEXP002 (#802): the Tasks extension marks its whole
         server surface [Experimental] (IMcpTaskStore, WithTasks, task
         notifications). There is no non-experimental equivalent to call
         instead, so the diagnostics are acknowledged here, scoped to this
         project, rather than with #pragma per call site (#355).
         https://github.com/modelcontextprotocol/csharp-sdk -->
    <NoWarn>$(NoWarn);MCPEXP001;MCPEXP002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="bowire" />
    <InternalsVisibleTo Include="Kuestenlogik.Bowire.Tests" />
    <InternalsVisibleTo Include="Kuestenlogik.Bowire.IntegrationTests" />
    <InternalsVisibleTo Include="Kuestenlogik.Bowire.Mcp.Tests" />
    <!-- Protocol.Mcp consults the dispatcher's RegisterAdapterHandlers
         seam (#287) to plug its handlers into the dual-mount routing
         when both Mcp + Protocol.Mcp are wired on the same host. -->
    <InternalsVisibleTo Include="Kuestenlogik.Bowire.Protocol.Mcp" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kuestenlogik.Bowire\Kuestenlogik.Bowire.csproj" />
    <!-- Bowire.Mock is referenced for Phase-3 mock lifecycle tools
         (bowire.mock.start / bowire.mock.stop). Without it the Mcp
         tools class can't drive MockServer.StartAsync. -->
    <ProjectReference Include="..\Kuestenlogik.Bowire.Mock\Kuestenlogik.Bowire.Mock.csproj" />
    <!-- #364 — the contract matrix tool reads the same stored results the
         workbench rail and `bowire contract matrix` render, so an agent
         gets the same view as the CLI and the UI. -->
    <ProjectReference Include="..\Kuestenlogik.Bowire.Contracts\Kuestenlogik.Bowire.Contracts.csproj" />
    <!-- #673 / #674 - bowire.import and bowire.export.http call the Interop rpc handler. -->
    <ProjectReference Include="..\Kuestenlogik.Bowire.Interop\Kuestenlogik.Bowire.Interop.csproj" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <!-- #802 - long Bowire tools (bowire.test.run) run as durable MCP tasks. -->
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" />
  </ItemGroup>
</Project>
