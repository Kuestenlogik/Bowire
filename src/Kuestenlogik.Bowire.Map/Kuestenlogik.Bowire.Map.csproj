<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Bowire UI extension — MapLibre GL JS map widget for the coordinate.wgs84 semantic kind. Ships the WebGL map viewer + editor as a separate package so users who never need geographic rendering don't pay the ~870 KB JS/CSS cost on every workbench load.</Description>
    <PackageId>Kuestenlogik.Bowire.Map</PackageId>
    <PackageTags>bowire;bowire-extension;maplibre;map;geospatial;wgs84;developer-tools</PackageTags>
    <IsPackable>true</IsPackable>
    <!-- Bowire's plugin / extension marker for the in-UI marketplace +
         NuGet consumers. Same shape as <PackageType>BowirePlugin</PackageType>
         on the Protocol.* projects, only the package-class differs. -->
    <PackageType>BowireExtension</PackageType>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kuestenlogik.Bowire.Map.Tests" />
    <InternalsVisibleTo Include="Kuestenlogik.Bowire.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kuestenlogik.Bowire\Kuestenlogik.Bowire.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Extension assets — served by the core
      /api/ui/extensions/kuestenlogik.maplibre/{name} endpoint via
      EmbeddedExtensionAsset.OpenRead against this assembly. The widget
      bundle and the MapLibre vendored stylesheet are the two hot-path
      assets (BundleResourceName / StylesResourceName on the descriptor);
      maplibre-gl.js and LICENSE are AdditionalAssets the bundle pulls in
      lazily when the first map widget mounts.
    -->
    <EmbeddedResource Include="wwwroot\js\widgets\map.js"
                      LogicalName="Kuestenlogik.Bowire.Map.wwwroot.js.widgets.map.js" />
    <EmbeddedResource Include="wwwroot\maplibre\maplibre-gl.js"
                      LogicalName="Kuestenlogik.Bowire.Map.wwwroot.maplibre.maplibre-gl.js" />
    <EmbeddedResource Include="wwwroot\maplibre\maplibre-gl.css"
                      LogicalName="Kuestenlogik.Bowire.Map.wwwroot.maplibre.maplibre-gl.css" />
    <EmbeddedResource Include="wwwroot\maplibre\LICENSE"
                      LogicalName="Kuestenlogik.Bowire.Map.wwwroot.maplibre.LICENSE" />
    <!--
      milsymbol (MIT) — renders a MIL-STD-2525 / APP-6 SIDC into the
      standard's own symbol frame + icon. Loaded lazily next to
      maplibre-gl.js when the first map widget mounts; a failed load
      leaves the widget on its four built-in affinity sprites. The
      licence file carries the library's name in its leaf because the
      asset endpoint resolves by leaf and `LICENSE` is already taken by
      MapLibre's.
    -->
    <EmbeddedResource Include="wwwroot\milsymbol\milsymbol.js"
                      LogicalName="Kuestenlogik.Bowire.Map.wwwroot.milsymbol.milsymbol.js" />
    <EmbeddedResource Include="wwwroot\milsymbol\milsymbol.LICENSE"
                      LogicalName="Kuestenlogik.Bowire.Map.wwwroot.milsymbol.milsymbol.LICENSE" />
    <!--
      mil-sym-ts (Apache-2.0) — the multipoint renderer for the tactical
      graphics milsymbol does not draw: boundaries, phase lines, areas,
      axes of advance, corridors, range fans. This is the upstream web
      build (`@armyc2.c5isr.renderer/mil-sym-ts-web` 2.10.4, C5Ren.umd.js,
      sha256 27403955…b0b85c), unmodified but stored gzipped: 7.4 MB of
      minified JS and inlined symbol tables compress to 1.36 MB, and the
      asset endpoint serves a `.gz`-declared asset under its plain leaf
      (`mil-sym-ts.js`), passing the bytes through with
      Content-Encoding: gzip when the client accepts it and inflating
      them when it does not. Loaded lazily, only once a frame carries a
      multipoint location; a workbench that never sees one never pays.
    -->
    <EmbeddedResource Include="wwwroot\mil-sym-ts\mil-sym-ts.js.gz"
                      LogicalName="Kuestenlogik.Bowire.Map.wwwroot.mil-sym-ts.mil-sym-ts.js.gz" />
    <EmbeddedResource Include="wwwroot\mil-sym-ts\mil-sym-ts.LICENSE"
                      LogicalName="Kuestenlogik.Bowire.Map.wwwroot.mil-sym-ts.mil-sym-ts.LICENSE" />
  </ItemGroup>
</Project>
