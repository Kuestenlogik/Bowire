<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>OpenID Connect auth provider for Bowire — concrete IBowireAuthProvider implementation built on Microsoft.Identity.Web so Azure AD, Okta, Keycloak, Auth0, and any OIDC-compliant IdP gate workbench access without provider-specific code paths. Ships as a standalone NuGet so installs that don't need OIDC don't pull Microsoft.Identity.Web's transitive weight.</Description>
    <PackageId>Kuestenlogik.Bowire.Auth.Oidc</PackageId>
    <PackageTags>bowire;auth;oidc;openid-connect;identity;microsoft-identity-web</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kuestenlogik.Bowire.Tests" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kuestenlogik.Bowire\Kuestenlogik.Bowire.csproj" />
    <PackageReference Include="Microsoft.Identity.Web" />
    <!-- Lifts Microsoft.Identity.Web's transitive 10.0.10 out of the
         advisories listed in Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- NU1510 is suppressed for this one reference only. This project
         references the ASP.NET Core shared framework, so NuGet prunes the
         package here and calls the reference unnecessary. It is not: it is
         what carries the 10.0.13 floor (GHSA-r955-8q5j-3h83) to every project
         and package consumer that reaches Microsoft.Identity.Web through this
         project without referencing the shared framework itself (prune rules
         follow a project's own FrameworkReference, not a transitive one).
         Without it, Auth.Oidc.Tests resolves Xml 10.0.10 again
         (the vulnerable-package listing reports it). -->
    <PackageReference Include="System.Security.Cryptography.Xml" NoWarn="NU1510" />
  </ItemGroup>
</Project>
