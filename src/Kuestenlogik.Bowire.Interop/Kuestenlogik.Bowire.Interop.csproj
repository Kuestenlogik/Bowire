<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- #673 / #674 — moving requests between Bowire and other API clients:
         import Insomnia, Bruno and .http, export .http. The first Bowire
         capability behind a gRPC service: the workbench reaches it through
         JSON transcoding, the CLI and MCP through the same rpc handler. -->
    <Description>Bowire interop — import Insomnia exports and .http files into Bowire collections, and export collections as .http. A gRPC service with JSON transcoding.</Description>
    <PackageId>Kuestenlogik.Bowire.Interop</PackageId>
    <PackageTags>bowire;import;export;insomnia;bruno;http-file;grpc</PackageTags>
    <IsPackable>true</IsPackable>
    <!-- Puts google/api/annotations.proto (Google.Api.CommonProtos) on the protoc import path. -->
    <IncludeGoogleApiCommonProtos>true</IncludeGoogleApiCommonProtos>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kuestenlogik.Bowire\Kuestenlogik.Bowire.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Google.Api.CommonProtos" />
    <PackageReference Include="Microsoft.AspNetCore.Grpc.JsonTranscoding" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\bowire\interop\v1\interop.proto" GrpcServices="Server" ProtoRoot="Protos" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\js\interop.js"
                      LogicalName="Kuestenlogik.Bowire.Interop.wwwroot.js.interop.js" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kuestenlogik.Bowire.Interop.Tests" />
  </ItemGroup>
</Project>
