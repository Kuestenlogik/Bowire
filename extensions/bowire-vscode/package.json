{
  "name": "bowire-vscode",
  "displayName": "Bowire",
  "description": "The Bowire multi-protocol API workbench, hosted in VS Code. gRPC, REST, GraphQL, SignalR, MQTT, WebSocket, SSE, MCP and more — with collections and environments stored in the workspace so they travel with the repo.",
  "version": "0.1.0",
  "publisher": "kuestenlogik",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "api",
    "grpc",
    "rest",
    "graphql",
    "websocket"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Kuestenlogik/Bowire"
  },
  "homepage": "https://bowire.io/",
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "bowire.openWorkbench",
        "title": "Bowire: Open workbench",
        "category": "Bowire"
      }
    ]
  },
  "icon": "icon.png",
  "scripts": {
    "vscode:prepublish": "node scripts/copy-icon.mjs"
  }
}
