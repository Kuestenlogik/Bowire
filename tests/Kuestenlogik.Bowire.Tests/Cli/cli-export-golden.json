      "rendered": "bowire call \\\n  --url rest@https://api.example.com \\\n  orders/createOrder \\\n  -d '{\"sku\":\"KL-1\",\"qty\":2}' \\\n  -H 'Authorization: Bearer static-token' \\\n  -H 'X-Tenant: north'",
