      "argv": ["bowire", "call", "--url", "<server-url>", "--protocol", "grpc", "weather.WeatherService/GetCurrentWeather", "-d", "{\"city\":\"Hamburg\"}"],
      "rendered": "bowire call \\\n  --url '<server-url>' \\\n  --protocol grpc \\\n  weather.WeatherService/GetCurrentWeather \\\n  -d '{\"city\":\"Hamburg\"}'",
      "notes": ["This workbench discovered the service in-process, so there is no server URL to copy. Replace <server-url> with the address the CLI should reach it on."]
