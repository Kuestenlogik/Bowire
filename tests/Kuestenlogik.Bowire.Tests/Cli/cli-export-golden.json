        "httpPath": "",
        "bodyJson": "{}",
        "bodyJsonRaw": "{}",
        "metadata": {},
        "metadataRaw": {},
        "source": "grpc",
        "protocolId": "grpc",
        "serverStreaming": true,
        "clientStreaming": false,
        "messages": ["{}"],
        "authKind": "none",
        "authLocation": ""
      },
      "argv": ["bowire", "call", "--url", "grpc@http://localhost:5001", "fleet.FleetService/WatchShips", "--stream"],
      "rendered": "bowire call \\\n  --url grpc@http://localhost:5001 \\\n  fleet.FleetService/WatchShips \\\n  --stream",
      "notes": []
    },
    {
      "scenario": "grpc-client-streaming-three-frames",
      "ctx": {
        "serverUrl": "http://localhost:5001",
        "service": "fleet.FleetService",
        "method": "UploadTrack",
        "httpMethod": "POST",
        "httpPath": "",
        "bodyJson": "{\"n\":1}",
        "bodyJsonRaw": "{\"n\":1}",
        "metadata": {},
        "metadataRaw": {},
        "source": "grpc",
        "protocolId": "grpc",
        "serverStreaming": false,
        "clientStreaming": true,
        "messages": ["{\"n\":1}", "{\"n\":2}", "{\"n\":3}"],
        "authKind": "none",
        "authLocation": ""
      },
      "argv": ["bowire", "call", "--url", "grpc@http://localhost:5001", "fleet.FleetService/UploadTrack", "-d", "{\"n\":1}", "-d", "{\"n\":2}", "-d", "{\"n\":3}"],
      "rendered": "bowire call \\\n  --url grpc@http://localhost:5001 \\\n  fleet.FleetService/UploadTrack \\\n  -d '{\"n\":1}' \\\n  -d '{\"n\":2}' \\\n  -d '{\"n\":3}'",
      "notes": ["Client-streaming: each -d is sent as one frame, then the send side closes. An interactive duplex session needs the workbench."]
    },
    {
