    {
      "scenario": "substitutes-plain-vars-but-never-secret-refs",
      "vars": { "region": "north" },
      "ctx": {
        "serverUrl": "https://api.example.com",
        "service": "orders",
        "method": "listOrders",
        "httpMethod": "GET",
        "httpPath": "/orders",
        "_note": "metadata carries what buildCodeExportContext produces — substituteVars has ALREADY resolved the secret there. The generator must read metadataRaw and resolve it itself, so the ref survives.",
        "bodyJson": "{\"region\":\"north\"}",
        "bodyJsonRaw": "{\"region\":\"{{region}}\"}",
        "metadata": { "Authorization": "Bearer glpat-LIVE-CREDENTIAL" },
        "metadataRaw": { "Authorization": "Bearer {{secret.deployToken}}" },
        "source": "rest",
        "protocolId": "rest",
        "serverStreaming": false,
        "clientStreaming": false,
        "messages": ["{\"region\":\"{{region}}\"}"],
        "authKind": "none",
        "authLocation": ""
      },
      "argv": ["bowire", "call", "--url", "rest@https://api.example.com", "orders/listOrders", "-d", "{\"region\":\"north\"}", "-H", "Authorization: Bearer {{secret.deployToken}}"],
      "rendered": "bowire call \\\n  --url rest@https://api.example.com \\\n  orders/listOrders \\\n  -d '{\"region\":\"north\"}' \\\n  -H 'Authorization: Bearer {{secret.deployToken}}'",
      "notes": ["{{secret.*}} / {{keyring.*}} refs are left unresolved on purpose. The CLI resolves them from --env-file, or from the OS keyring with --keyring on `bowire test`."]
    },
