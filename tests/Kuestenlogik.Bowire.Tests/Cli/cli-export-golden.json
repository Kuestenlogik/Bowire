        "bodyJson": "{\"id\":\"101\"}",
        "bodyJsonRaw": "{\"id\":\"{{shipId}}\"}",
        "metadata": { "x-region": "north" },
        "metadataRaw": { "x-region": "{{region}}" },
        "source": "grpc",
        "protocolId": "grpc",
        "serverStreaming": false,
        "clientStreaming": false,
        "messages": ["{\"id\":\"{{shipId}}\"}"],
        "authKind": "none",
