    {
      "scenario": "keep-variables-emits-var-pairs",
      "keepVars": true,
      "vars": { "shipId": "101", "region": "north" },
      "ctx": {
        "serverUrl": "http://localhost:5001",
        "service": "fleet.FleetService",
        "method": "GetShip",
