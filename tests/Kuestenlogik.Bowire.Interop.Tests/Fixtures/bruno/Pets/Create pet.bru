meta {
  name: Create pet
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/pets
  body: json
  auth: basic
}

headers {
  @description('''
    Trace id for the request
  ''')
  X-Request-Id: {{$randomUUID}}
}

auth:basic {
  username: admin
  password: hunter2
}

body:json {
  {
    "name": "Rex",
    "tag": "dog"
  }
}

script:pre-request {
  req.setHeader("X-Time", Date.now());
}
