  "images": "images",
  "roles": {
    "ink": { "light": "#003e60", "dark": "#ffffff", "source": ["#000000"], "why": "the bw and its ring, drawn black: Küstenlogik's navy ink on light (11.3:1 on white), white on dark (navy on #121212 would be 1.7:1)" }
  },
  "wordmarkRole": "ink",
