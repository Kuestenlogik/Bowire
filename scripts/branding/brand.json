{
  "$comment": "Bowire's logo set for the shared generator (scripts/branding/tool, #964, #965). Paths are relative to the repository root. See scripts/branding/README.md.",
  "root": "../..",
  "product": "Bowire",
  "prefix": "bowire",
  "source": "scripts/branding/bowire_mark_source.svg",
