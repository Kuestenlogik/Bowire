    { "name": "bowire.ico", "sizes": [16, 24, 32, 48, 64, 128, 256], "art": "tile" },
    { "name": "bowire.icns", "sizes": [16, 32, 64, 128, 256, 512, 1024], "art": "tile" },
    { "name": "bowire_app_256.png", "size": 256, "art": "tile" }
  ],
  "kit": { "path": "site/assets/brand/bowire_brand_kit.zip" },
  "inline": [
    "site/_includes/*.html",
    "site/_layouts/*.html",
