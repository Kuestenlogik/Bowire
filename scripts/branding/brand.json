    { "dir": "site/assets/images", "files": ["favicon.svg", "favicon.ico", "apple-touch-icon.png", "og-image.png", "bowire_mark_colored.svg", "bowire_mark_white.svg"] },
    { "dir": "site/assets/brand", "files": ["bowire_mark_colored.svg", "bowire_mark_white.svg", "bowire_emblem_colored.svg", "bowire_emblem_white.svg", "bowire_lockup_h_colored.svg", "bowire_lockup_h_white.svg"] },
    { "dir": "docs/images/brand", "files": ["bowire_mark_colored.svg", "bowire_mark_white.svg", "bowire_emblem_colored.svg", "bowire_emblem_white.svg", "bowire_lockup_h_colored.svg", "bowire_lockup_h_white.svg"] },
    { "dir": "docs", "files": ["favicon.ico"] },
    { "dir": "docs/templates/bowire/public", "files": ["favicon.svg"] },
    { "dir": "src/Kuestenlogik.Bowire/wwwroot", "files": ["bowire_mark_colored.svg", "bowire_mark_white.svg", "bowire_emblem_colored.svg", "bowire_emblem_white.svg"] },
    { "dir": "packaging/macos/Bowire.app/Contents/Resources", "files": ["bowire.icns"] }
  ]
